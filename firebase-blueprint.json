{
  "entities": {
    "Medicine": {
      "title": "Medicine",
      "description": "Medicine or surgical item inventory record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "genericName": { "type": "string" },
        "manufacturer": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "shelfLocation": { "type": "string" },
        "batchNumber": { "type": "string" },
        "stock": { "type": "number" },
        "unit": { "type": "string" },
        "minStock": { "type": "number" },
        "unitCost": { "type": "number" },
        "retailPrice": { "type": "number" },
        "expiryDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "sku", "stock", "retailPrice"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Dispensary transaction invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "time": { "type": "string" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "customerType": { "type": "string" },
        "doctor": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "cashier": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "totalAmount"]
    },
    "StoreAuth": {
      "title": "StoreAuth",
      "description": "Store admin credentials and security settings",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username", "password"]
    },
    "CustomerKhata": {
      "title": "CustomerKhata",
      "description": "Customer credit account (Udhar / Khata ledger record)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "cnic": { "type": "string" },
        "address": { "type": "string" },
        "totalDebt": { "type": "number" },
        "creditLimit": { "type": "number" },
        "lastTransactionDate": { "type": "string" },
        "transactions": { "type": "array" }
      },
      "required": ["id", "name", "phone", "totalDebt"]
    }
  },
  "firestore": {
    "/medicines/{medicineId}": {
      "schema": { "$ref": "#/entities/Medicine" },
      "description": "Collection of pharmacy medicines and surgical items"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Collection of dispensary sales invoices"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreAuth" },
      "description": "System settings and admin authentication credentials"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerKhata" },
      "description": "Collection of customer Khata accounts and credit ledgers"
    }
  }
}
